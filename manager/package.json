{
  "name": "publication-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker/index.ts",
    "import": "tsx --env-file=.env src/import/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:test:setup": "docker exec pm-postgres psql -U pm -d postgres -c 'CREATE DATABASE publication_manager_test' || true && DATABASE_URL=postgresql://pm:pm@localhost:5435/publication_manager_test prisma migrate deploy",
    "limpar-ensaios": "tsx --env-file=.env src/import/limpar-ensaios.ts",
    "worker:prod": "tsx src/worker/index.ts",
    "import:prod": "tsx src/import/cli.ts",
    "checar-canal": "tsx --env-file=.env src/import/checar-canal.ts",
    "checar-canal:prod": "tsx src/import/checar-canal.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "minio": "^8.0.7",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
