# ------------------------------------------------------------------ banco
DATABASE_URL=postgresql://dark:dark@localhost:5436/dark

# ------------------------------------------------------------------ auth
# Usuário único administrativo. Nunca versionar valores reais.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-isso
# Segredo de assinatura do cookie de sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=troque-isso-por-32-bytes-aleatorios
# Chave de cifra das credenciais de canal no banco. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=troque-isso-por-64-caracteres-hex

# ------------------------------------------------------------------ storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=pmadmin
MINIO_SECRET_KEY=pmadmin123
MINIO_BUCKET=dark-media

# ------------------------------------------------------------------ URL pública das mídias
# A Meta baixa a mídia por URL — precisa ser alcançável pela internet.
#   minio      → usa MEDIA_PUBLIC_BASE_URL (o DNS do MinIO no VPS). Produção.
#   cloudinary → espelha o arquivo no Cloudinary só pra gerar a URL. Desenvolvimento.
PUBLIC_URL_PROVIDER=cloudinary
MEDIA_PUBLIC_BASE_URL=https://media.seudominio.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------ Instagram
# Fallback global. Credencial por projeto vive cifrada em ChannelConfig.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ------------------------------------------------------------------ publicação
# true = nada é publicado de verdade. Mantenha true até a Fase 10.
PUBLISHING_DRY_RUN=true
WORKER_POLL_INTERVAL_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=15000
# Depois desse tempo sem heartbeat o dashboard mostra o worker offline.
WORKER_OFFLINE_AFTER_MS=60000
# Publicação presa em PUBLISHING além disso tem o lock recuperado.
LOCK_TIMEOUT_MS=900000

# ------------------------------------------------------------------ import
# Raiz do sistema antigo, relativa a manager/.
LEGACY_CONTENT_ROOT=../marketing/conteudo
