# Credenciais de UM canal. Copie para canais/<slug>/.env (nunca vai pro git).
# Cada canal mora numa brand account própria do YouTube: não ligue todos a uma conta só.

# ------------------------------------------------------------------ YouTube
# ID do canal (começa com UC). youtube.com → foto → Configurações → Configurações avançadas.
# Trava de segurança: o upload recusa publicar se o canal autorizado for outro.
YT_CANAL_ID=
# URL pública, ex.: https://www.youtube.com/@marginnotes
YT_CANAL_URL=
# Onde ficam a credencial OAuth (client_secret.json) e o token do canal.
# Padrão sugerido: canais/<slug>/secrets (fora do git).
YT_SECRETS_DIR=

# ------------------------------------------------------------------ Instagram (via Meta Graph API)
# Conta Instagram profissional ligada a uma Página do Facebook do canal.
# developers.facebook.com → app → Graph API Explorer → token da Página (de longa duração).
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------------ TikTok
# Publicação manual por enquanto (API de conteúdo exige aprovação do app).
